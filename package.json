{
  "name": "corkboard",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "bun bridge/server.ts --dev",
    "build": "vite build web",
    "build:meet": "vite build -c web/vite.meet.config.ts",
    "dev:web": "vite web",
    "portraits": "bun web/portraits.ts",
    "lines": "bun web/lines.ts",
    "app": "electron app",
    "build:bridge": "bun scripts/build-bridge.ts",
    "dist": "bun scripts/build-bridge.ts --target os && bun run --cwd app dist --publish never",
    "typecheck": "tsc -p .",
    "mcp": "bun mcp/board.ts",
    "latency": "bun bridge/latency.ts",
    "login": "bun bridge/cloud.ts login",
    "test:fleet": "bun test --isolate fleet/fleetd fleet/guest",
    "test:e2ee": "bun test lib/e2ee bridge/keystore bridge/forge bridge/node forge"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@huggingface/transformers": "4.3.2",
    "@msgpack/msgpack": "^3.0.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@pixiv/three-vrm": "3.5.5",
    "@scure/bip39": "^2.4.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "isomorphic-git": "^1.44.8",
    "kokoro-js": "1.2.1",
    "marked": "^18.1.1",
    "ogg-opus-decoder": "^1.7.5",
    "react": "19",
    "react-dom": "19",
    "sherpa-onnx-node": "2.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@huggingface/transformers": "4.3.2"
  }
}
