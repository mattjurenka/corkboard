{
  "name": "corkboard",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "bun bridge/server.ts --dev",
    "build": "vite build web",
    "build:meet": "vite build -c web/vite.meet.config.ts",
    "dev:web": "vite web",
    "portraits": "bun web/portraits.ts",
    "lines": "bun web/lines.ts",
    "app": "electron app",
    "build:bridge": "bun scripts/build-bridge.ts",
    "dist": "bun scripts/build-bridge.ts --target os && bun run --cwd app dist --publish never",
    "typecheck": "tsc -p .",
    "lint:keys": "bun scripts/lint-keys.ts",
    "mcp": "bun mcp/board.ts",
    "latency": "bun bridge/latency.ts",
    "login": "bun bridge/cloud.ts login",
    "test:fleet": "bun test --isolate fleet/fleetd fleet/guest",
    "test:e2ee": "bun test lib/harden.test.ts lib/e2ee bridge/keystore bridge/forge bridge/node forge",
    "test:lib": "bun test lib/think.test.ts lib/acp lib/memory lib/model fleet/caps packaging",
    "test:bridge": "bun test --isolate ./bridge/{agents,guard,e2ee,listen,record,dirs,away,cloud-session,sessions,boards,acp,forge-git}.test.ts",
    "test:mcp": "bun test ./mcp",
    "test:nvim": "bun test ./nvim/hooks ./nvim/*.test.ts",
    "test:web": "bun test web/src/lib web/src/e2ee web/src/avatar web/src/components web/src/views web/src/testing web/src/reconnect.test.ts web/src/nvim/input.test.ts web/src/nvim/input.dom.test.ts web/src/nvim/rpc.test.ts web/src/nvim/grid.test.ts web/src/nvim/wasm wasm",
    "test:live": "nix shell --inputs-from . nixpkgs#opencode nixpkgs#codex-acp -c bun test --timeout 120000 ./lib/acp/live.ts ./bridge/node/embed.live.ts",
    "test:terminal": "bun test ./web/src/nvim/terminal.test.ts",
    "fuzz": "FUZZ_RUNS=${FUZZ_RUNS:-3000} bun test --timeout 0 lib/e2ee/test/*.fuzz.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@huggingface/transformers": "4.3.2",
    "@msgpack/msgpack": "^3.0.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@pixiv/three-vrm": "3.5.5",
    "@scure/bip39": "^2.4.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "isomorphic-git": "^1.44.8",
    "kokoro-js": "1.2.1",
    "marked": "^18.1.1",
    "ogg-opus-decoder": "^1.7.5",
    "react": "19",
    "react-dom": "19",
    "sherpa-onnx-node": "2.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "6.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@huggingface/transformers": "4.3.2"
  }
}
