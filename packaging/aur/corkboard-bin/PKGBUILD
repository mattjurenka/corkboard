# Maintainer: Matt Jurenka <m@trystable.co>
#
# The release's Linux tarball (electron-builder's tar.gz: Electron, the
# compiled bridge and Neovim), in /opt/corkboard. It doesn't update itself;
# a new release is a new pkgver (packaging/aur/update.sh).
pkgname=corkboard-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Neovim with Claude Code agents beside it"
arch=('x86_64' 'aarch64')
url="https://corkboard.fyi"
license=('LicenseRef-corkboard')
depends=('git' 'claude-code' 'ripgrep' 'fd' 'gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'libsecret' 'xdg-utils')
provides=('corkboard')
conflicts=('corkboard')
options=('!strip' '!debug')
_release="https://github.com/mattjurenka/corkboard/releases/download/v${pkgver}"
source=("corkboard.desktop"
        "corkboard-${pkgver}.png::https://raw.githubusercontent.com/mattjurenka/corkboard/v${pkgver}/app/build/icons/512x512.png")
source_x86_64=("${_release}/corkboard-${pkgver}-linux-x64.tar.gz")
source_aarch64=("${_release}/corkboard-${pkgver}-linux-arm64.tar.gz")
sha256sums=('SKIP'
            'SKIP')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local _arch=x64
  [ "$CARCH" = aarch64 ] && _arch=arm64
  install -d "$pkgdir/opt/corkboard" "$pkgdir/usr/bin"
  cp -a "corkboard-${pkgver}-linux-${_arch}/." "$pkgdir/opt/corkboard/"
  chmod 4755 "$pkgdir/opt/corkboard/chrome-sandbox"
  ln -s /opt/corkboard/corkboard "$pkgdir/usr/bin/corkboard"
  install -Dm644 corkboard.desktop "$pkgdir/usr/share/applications/corkboard.desktop"
  install -Dm644 "corkboard-${pkgver}.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/corkboard.png"
}
