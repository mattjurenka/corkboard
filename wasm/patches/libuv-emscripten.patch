    */
   for (;;) {
     uv__io_poll_prepare(loop, pset, timeout);
+#ifdef __EMSCRIPTEN__
+    /* Emscripten's poll() never blocks. Check readiness first, then let the
+     * host block until input arrives or the timeout expires. */
+    nfds = poll(loop->poll_fds, (nfds_t)loop->poll_fds_used, 0);
+    if (nfds == 0 && timeout != 0) {
+      uv__emscripten_wait(timeout);
+      nfds = poll(loop->poll_fds, (nfds_t)loop->poll_fds_used, 0);
+    }
+#else
