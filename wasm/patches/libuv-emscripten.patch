diff --git a/src/threadpool.c b/src/threadpool.c
index 2a129a5..fb1f7cf 100644
--- a/src/threadpool.c
+++ b/src/threadpool.c
@@ -278,11 +278,25 @@ void uv__work_submit(uv_loop_t* loop,
                      enum uv__work_kind kind,
                      void (*work)(struct uv__work* w),
                      void (*done)(struct uv__work* w, int status)) {
+#ifdef __EMSCRIPTEN__
+  /* No threads: run the work inline and complete it on the next loop
+   * iteration, exactly as a worker thread would. */
+  w->loop = loop;
+  w->done = done;
+  work(w);
+
+  uv_mutex_lock(&loop->wq_mutex);
+  w->work = NULL;
+  uv__queue_insert_tail(&loop->wq, &w->wq);
+  uv_async_send(&loop->wq_async);
+  uv_mutex_unlock(&loop->wq_mutex);
+#else
   uv_once(&once, init_once);
   w->loop = loop;
   w->work = work;
   w->done = done;
   post(&w->wq, kind);
+#endif
 }
 
 
