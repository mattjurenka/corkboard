+/* Called by uv__io_poll when nothing is ready. A host embedding libuv can
+ * set Module.uvWait(timeout_ms) to block (timeout -1 means forever) until it
+ * has input; without it the loop spins. */
+EM_JS(void, uv__emscripten_wait, (int timeout), {
+  if (Module.uvWait) Module.uvWait(timeout);
+});
