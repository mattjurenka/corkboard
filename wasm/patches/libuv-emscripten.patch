+ * IN THE SOFTWARE.
+ */
+
+/* Emscripten platform: a single-threaded sandbox with no processes, no
+ * network interfaces and no meaningful system statistics. */
+
+#include "uv.h"
+#include "internal.h"
+
+#include <emscripten/heap.h>
+#include <stdlib.h>
+#include <string.h>
+
+int uv_exepath(char* buffer, size_t* size) {
+  if (buffer == NULL || size == NULL || *size == 0)
+    return UV_EINVAL;
+
+  *size = uv__strscpy(buffer, "/bin/nvim", *size);
+  return 0;
+}
+
+int uv_resident_set_memory(size_t* rss) {
+  *rss = emscripten_get_heap_size();
+  return 0;
+}
+
+uint64_t uv_get_free_memory(void) {
+  return emscripten_get_heap_max() - emscripten_get_heap_size();
+}
+
+uint64_t uv_get_total_memory(void) {
+  return emscripten_get_heap_max();
+}
+
+uint64_t uv_get_constrained_memory(void) {
+  return 0;  /* no constraint known */
+}
+
+uint64_t uv_get_available_memory(void) {
+  return uv_get_free_memory();
+}
+
+int uv_uptime(double* uptime) {
+  *uptime = uv_hrtime() / 1e9;
+  return 0;
+}
+
+void uv_loadavg(double avg[3]) {
+  avg[0] = avg[1] = avg[2] = 0;
+}
+
+int uv_cpu_info(uv_cpu_info_t** cpu_infos, int* count) {
+  *cpu_infos = uv__calloc(1, sizeof(**cpu_infos));
+  if (*cpu_infos == NULL)
+    return UV_ENOMEM;
+
+  (*cpu_infos)->model = uv__strdup("wasm");
+  if ((*cpu_infos)->model == NULL) {
+    uv__free(*cpu_infos);
+    return UV_ENOMEM;
+  }
+
+  *count = 1;
+  return 0;
+}
+
+int uv_interface_addresses(uv_interface_address_t** addresses, int* count) {
+  *addresses = NULL;
+  *count = 0;
+  return 0;
+}
