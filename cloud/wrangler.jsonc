// corkboard's boards on Cloudflare: one Durable Object per board, its cards in
// the object's own SQLite; one per user, listing their boards. Sign-in is
// Google, through the OAuth provider, whose state lives in OAUTH_KV. See
// .agent/plans/cloud-boards.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corkboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Outbound fetches reach only the public internet: the OAuth provider
  // needs it to fetch clients' metadata documents (CIMD) safely.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  // The portal, the API, /mcp and sign-in, on the account that owns corkboard.fyi.
  "routes": [{ "pattern": "portal.corkboard.fyi", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "Board" },
      { "name": "USER", "class_name": "User" },
      // One per user and brain: its memory (src/memory.ts).
      { "name": "MEMORY", "class_name": "Memory" },
      // Who's let in, and the invites (src/registry.ts): one for the Worker.
      { "name": "REGISTRY", "class_name": "Registry" },
      // End-to-end encrypted accounts (src/e2ee.ts): logs of ciphertext, and
      // pairing mailboxes.
      { "name": "LOG", "class_name": "Log" },
      { "name": "MAILBOX", "class_name": "Mailbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Board"] },
    { "tag": "v2", "new_sqlite_classes": ["User"] },
    { "tag": "v3", "new_sqlite_classes": ["Memory"] },
    { "tag": "v4", "new_sqlite_classes": ["Registry"] },
    { "tag": "v5", "new_sqlite_classes": ["Log", "Mailbox"] }
  ],
  // Recall by meaning: embeddings from Workers AI, in one index with a
  // namespace per brain (src/memory.ts).
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORS", "index_name": "corkboard-memory" }],
  // Files agents attach to cards (src/media.ts).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "corkboard-media" }],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "8f69c7790e394751a12b04353f29adc9" },
    // What brains hold, and their secrets (src/holds.ts).
    { "binding": "HOLDS", "id": "20209fd6bce6426e8459f7aa20f5d8eb" }
  ],
  // The editor with no machine behind it (wasm/edit-page.ts), at /edit/:
  // deploy.sh builds it, on this machine's plugins. Served before the
  // Worker runs, for the paths it has.
  "assets": { "directory": "./.edit" },
  // The portal's page (../portal), served for every path that isn't ours.
  "services": [{ "binding": "PORTAL", "service": "corkboard-portal" }],
  "vars": {
    "ORIGIN": "https://portal.corkboard.fyi",
    // Always let in, as admins (src/registry.ts); anyone else needs an invite.
    "ADMIN_EMAILS": "matthewjurenka@gmail.com",
    // The first admin's zone and calendar from before each user had their
    // own (src/user.ts's settings), which theirs start from.
    "TIMEZONE": "America/Phoenix",
    // The dayplan-512206 project's Web application client.
    "GOOGLE_CLIENT_ID": "911829084497-iab0dt2ufoiobeot2uanudsc1tc02s8o.apps.googleusercontent.com",
    // The Claude calendar, which accepted plans go on (src/calendar.ts).
    "CALENDAR_ID": "d4d3457c1699083d464ecbfc9817359e17534ad8c8056a346aed1d35db5f6633@group.calendar.google.com",
    // The portal's file browser (src/git.ts); FORGEJO_TOKEN is a secret.
    "FORGEJO_ORIGIN": "https://git.corkboard.fyi"
  }
  // Secrets (wrangler secret put): GOOGLE_CLIENT_SECRET, FORGEJO_TOKEN, and
  // HOLDS_KEY, what holds' secrets are encrypted with (src/holds.ts). See
  // DEPLOY-NOTES.md.
}
