{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["bun", "vite/client"],
    "paths": { "@/*": ["./web/src/*"] }
  },
  "include": ["web/src", "web/vite.config.ts", "mcp"]
}
